/* Text colours keep at least 4.5:1 contrast on their backgrounds; decorative accents stay brand pink. */

/* ==================== 基础 ==================== */
.container {
  padding: 0 24rpx 60rpx;
}

/* ==================== 状态卡 ==================== */
.status-card {
  margin: 32rpx 0 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 138, 0.12);
}
.status-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #c2405f;
  line-height: 1.4;
}
.status-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5c5c5c;
  line-height: 1.6;
}
.status-period {
  background: #fff0f3;
}
.status-alert .status-title {
  color: #a12d46;
}

/* ==================== 月份导航 ==================== */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 24rpx;
}
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.1);
}
.nav-arrow {
  font-size: 44rpx;
  color: #ff6b8a;
  font-weight: 300;
  margin-top: -4rpx;
}
.month-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ==================== 今天按钮 ==================== */
.today-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}
.today-btn-centered {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 48rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 2rpx solid #ff6b8a;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 138, 0.1);
}
.today-btn-text {
  font-size: 26rpx;
  color: #c2405f;
  font-weight: 600;
}

.pending-tip {
  text-align: center;
  font-size: 24rpx;
  color: #a4415c;
  margin-bottom: 12rpx;
  background: #fff0f3;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
}
.pending-date {
  font-weight: 700;
}

/* ==================== 星期行 ==================== */
.weekday-row {
  display: flex;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 18rpx 0 10rpx;
}
.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b6b6b;
}
.text-weekend {
  color: #c2405f;
}

/* ==================== 日历网格 ==================== */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
  padding-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.day-cell {
  width: calc(100% / 7);
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-num {
  font-size: 28rpx;
  color: #333;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  position: relative;
}

.day-tag {
  font-size: 20rpx;
  color: #fff;
  position: absolute;
  top: 4rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}
.start-tag {
  background: #c2405f;
  right: 4rpx;
}
.end-tag {
  background: #c2405f;
  left: 4rpx;
}

.ovu-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3d82d9;
  margin-top: 2rpx;
}
/* Fertile days that are not ovulation days get a bar, so the meaning does not rely on colour. */
.fertile-bar {
  width: 24rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2e7d4a;
  margin-top: 4rpx;
}

.review-tag {
  font-size: 18rpx;
  color: #7a5c10;
  position: absolute;
  bottom: 2rpx;
}

/* ---- 非当月（可点击，会切换到那个月） ---- */
.day-cell.dimmed .day-num {
  color: #949494;
}

/* ---- 经期中间日 ---- */
.day-cell.period-mid {
  background: #ffe0e6;
}
.day-cell.period-mid .day-num {
  color: #333;
}

/* ---- 经期首/尾 ---- */
.day-cell.period-start {
  background: #ff9eaf;
  border-radius: 16rpx 0 0 16rpx;
}
.day-cell.period-end {
  background: #ff9eaf;
  border-radius: 0 16rpx 16rpx 0;
}
.day-cell.period-start.period-end {
  border-radius: 16rpx;
}
.day-cell.period-start .day-num,
.day-cell.period-end .day-num {
  color: #7a1f35;
  font-weight: 700;
}

/* ---- 预测与估计窗口 ---- */
.day-cell.predicted {
  background: #fff5f7;
}
.day-cell.predicted .day-num {
  color: #c2405f;
  border: 2rpx dashed #e8738a;
}
.day-cell.unreviewed {
  background: #fff4cd;
}
.day-cell.fertile {
  background: #d3efd9;
}

/* ---- 今天，然后是待定开始日：同一天时待定开始日更醒目 ---- */
.day-cell.today .day-num {
  color: #2f6fc4;
  font-weight: 700;
  border: 3rpx solid #2f6fc4;
}
.day-cell.pending .day-num {
  color: #c2405f;
  font-weight: 700;
  background: #fff0f3;
  border: 3rpx solid #c2405f;
}

/* ==================== 卡片 ==================== */
.section-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.card-sub {
  font-size: 22rpx;
  color: #707070;
}
.card-arrow {
  font-size: 22rpx;
  color: #8c8c8c;
}

/* ==================== 图例 ==================== */
.legend-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin-right: 36rpx;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #5c5c5c;
}
.legend-swatch {
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}
.swatch-period {
  background: #ff9eaf;
}
.swatch-ovulation {
  background: #fff;
  border: 2rpx solid #c9dbf3;
}
.swatch-predicted {
  background: #fff5f7;
  border: 2rpx dashed #e8738a;
}
.swatch-review {
  background: #fff4cd;
}
.swatch-fertile {
  background: #d3efd9;
}
/* The legend shows the same dot and bar as the calendar. */
.swatch-ovulation,
.swatch-fertile {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.legend-swatch .ovu-dot,
.legend-swatch .fertile-bar {
  margin-top: 0;
}

/* ==================== 统计面板 ==================== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.stat-item {
  width: 50%;
  margin-bottom: 22rpx;
}
.stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  word-break: break-all;
}
.stat-value.highlight {
  color: #c2405f;
}
.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #707070;
}
.stat-label {
  font-size: 22rpx;
  color: #707070;
  margin-top: 6rpx;
}
.model-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #707070;
  line-height: 1.6;
}

/* ==================== 外推候选经期 ==================== */
.upcoming-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.upcoming-title {
  font-size: 24rpx;
  color: #707070;
  margin-bottom: 16rpx;
}
.upcoming-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.upcoming-item {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}
.upcoming-range {
  font-size: 22rpx;
  color: #707070;
}
.upcoming-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff6b8a;
  flex-shrink: 0;
}
.upcoming-date {
  font-size: 24rpx;
  color: #333;
}

/* ==================== 记录列表 ==================== */
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.record-date {
  font-size: 25rpx;
  color: #333;
}
.record-status {
  font-size: 22rpx;
  color: #a4415c;
  flex-shrink: 0;
}
.review-status {
  color: #7a5c10;
}

/* ==================== 设置 ==================== */
.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.setting-label {
  display: flex;
  flex-direction: column;
}
.setting-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.setting-hint {
  font-size: 22rpx;
  color: #707070;
  margin-top: 4rpx;
}
.picker-value {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #fff0f3;
  color: #a4415c;
  font-size: 26rpx;
  font-weight: 600;
}

/* ==================== 底部 ==================== */
.footer {
  margin-top: 48rpx;
  text-align: center;
}
.reset-btn {
  font-size: 24rpx !important;
  color: #707070 !important;
  background: none !important;
  border: none !important;
  line-height: 1 !important;
}
.reset-btn::after {
  border: none;
}
.footer-text {
  font-size: 22rpx;
  color: #707070;
  margin-top: 12rpx;
}

/* ==================== 弹窗 ==================== */
.setup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.setup-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.setup-header {
  text-align: center;
  margin-bottom: 36rpx;
}
.setup-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.setup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 10rpx;
}
.setup-desc {
  font-size: 24rpx;
  color: #707070;
  line-height: 1.6;
}
.setup-body {
  margin-bottom: 32rpx;
}
.setup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.setup-row:first-child {
  border-top: none;
}
.setup-label {
  display: flex;
  flex-direction: column;
}
.setup-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.setup-hint {
  font-size: 22rpx;
  color: #707070;
  margin-top: 4rpx;
}
.setup-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.setup-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.setup-btn-primary {
  background: linear-gradient(135deg, #ff6b8a, #ff8fa3);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.25);
}
.setup-btn-ghost {
  background: transparent;
  color: #707070;
  font-weight: 400;
  font-size: 26rpx;
}

/* ==================== 编辑与提示 ==================== */
.notice-card {
  margin: 20rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff9e6;
  color: #6e5410;
  font-size: 24rpx;
  line-height: 1.6;
}
.error-card {
  margin-top: 32rpx;
  background: #fff0f3;
  color: #a12d46;
}
.error-hint {
  margin-top: 12rpx;
}
.editor-modal {
  max-height: 85vh;
  overflow-y: auto;
}
.editor-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
  font-size: 26rpx;
}
.date-input {
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #fff0f3;
  color: #b14461;
}
.gap-label {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.editor-actions,
.draft-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.primary-action,
.secondary-action,
.delete-action,
.small-action {
  font-size: 24rpx;
  margin: 12rpx 0 0;
  border-radius: 12rpx;
}
.primary-action {
  background: #c2405f;
  color: #fff;
}
.secondary-action,
.small-action {
  background: #fff0f3;
  color: #a4415c;
}
.delete-action {
  background: #fff;
  color: #a12d46;
}
.small-action {
  margin: 0;
  padding: 0 20rpx;
  font-size: 22rpx;
}
